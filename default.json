{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "America/Chicago",
  "minimumReleaseAge": "5 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "lockFileMaintenance": { "enabled": true },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "description": "Fast-track security fixes, but keep a short 12h cooldown (their default bypasses minimumReleaseAge entirely)",
    "minimumReleaseAge": "12 hours"
  },
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "labels": ["dependencies"],
  "assignees": ["ervwalter"],
  "packageRules": [
    {
      "description": "Batch major updates into one PR per dependency manager",
      "matchUpdateTypes": ["major"],
      "groupName": "{{manager}} major dependencies",
      "groupSlug": "{{manager}}-major-dependencies"
    },
    {
      "description": "Batch all non-major updates into one PR",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "all non-major dependencies"
    },
    {
      "description": "Pinning to what is already in use introduces nothing new, so skip the release-age gate for pin updates",
      "matchUpdateTypes": ["pin", "pinDigest"],
      "minimumReleaseAge": null
    }
  ]
}
